# Copy to .env for local work. Names only; every value below is empty or obviously fake.
# Real values live in the Netlify UI per deploy context (see docs/operations.md).
# Never commit a real value. Local dev needs none of these (defaults in docs/architecture.md section 5).

# local | test | preview | production. Drives safety guards and cookie flags.
APP_ENV=local
# file (local) | memory (tests) | netlify-blobs (preview and production).
STORE_DRIVER=file
# Folder for the local file store (file driver only).
DATA_DIR=.data/store
# Blobs store suffix: "preview" on previews, "production" only on production.
DATA_NAMESPACE=
# file (local) | memory (tests) | resend (preview and production).
EMAIL_DRIVER=file
# Folder for the local email outbox (file driver only).
EMAIL_OUTBOX_DIR=.data/outbox
# SECRET. Resend API key. Use a separate key for previews.
RESEND_API_KEY=
# Previews only (required there): every email goes to this one test inbox. Must be unset in production.
EMAIL_REDIRECT_TO=
# Daniella's admin sign-in email (also the admin allowlist).
ADMIN_EMAIL=admin@example.test
# SECRET. pbkdf2-sha256$600000$<salt>$<key>; make one with: npm run admin:hash
ADMIN_PASSWORD_HASH=
# SECRET. 32+ random bytes, base64url. Signs admin sessions; rotating it signs everyone out.
ADMIN_SESSION_SECRET=replace-me-with-32-or-more-random-bytes-not-real
# SECRET. Optional base32 TOTP secret for a second sign-in factor (recommended in production).
ADMIN_TOTP_SECRET=
# Used for links inside emails. Falls back to Netlify's URL when empty.
PUBLIC_BASE_URL=http://localhost:5173
# Preview only (optional): test payment link in place of the real one. Ignored in production.
PAYMENT_LINK_OVERRIDE_URL=
# Local and test only: pins the clock, e.g. 2026-12-01T09:00:00-05:00. Ignored elsewhere.
FAKE_NOW=
# Load tests only (preview concurrency run): set to 1 to switch off rate limits. Ignored in production.
RATE_LIMIT_DISABLED=
# info (default) | debug. Neither ever logs personal details.
LOG_LEVEL=info
